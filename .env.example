# Google Gemini AI Key for dynamic executive summaries and developer recommendations
# (Optional: If empty, the built-in deterministic heuristic rule engine generates structured fixes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google PageSpeed Insights API Key
# (Optional: Google allows free quota for standard requests without an API key)
PAGESPEED_API_KEY=

# DomCop Open PageRank API Key
# (Optional: Free 300,000 queries/month from https://openpagerank.com/ to sync live Common Crawl domain ranks)
OPENPAGERANK_API_KEY=

# PostgreSQL Database (Google Cloud SQL or local PostgreSQL)
# (Optional: If empty, uses in-memory repository for zero-dependency local development)
DATABASE_URL=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
